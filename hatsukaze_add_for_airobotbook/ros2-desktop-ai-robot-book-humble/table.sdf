# /home/ubuntu/airobot_ws/install/crane_plus_gazebo/share/crane_plus_gazebo/worlds/table.sdf を置き換える

<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <!-- センサレンダリング用システムプラグイン -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Ground%20Plane
      </uri>
    </include>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Table
      </uri>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </include>

   <!-- 一辺8.0cmのターゲットボックス -->
    <model name="target_box">
      <!-- x=0.175m (ロボット側へ1.5cm移動), y=-0.020m, z=1.04m -->
     <pose>0.173 -0.010 1.04 0 0 0</pose> 
      <link name="link">
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.000128</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000128</iyy>
            <iyz>0</iyz>
            <izz>0.000128</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 外部カメラの追加 -->
    <model name="external_camera">
      <static>true</static>
      <!-- テーブル上のアームベース(z=1.015m)とキューブを見下ろす位置設定 -->
      <pose>0.35 -0.35 1.35 0 0.6 2.35</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
        </visual>
        <sensor name="external_camera_sensor" type="camera">
          <topic>/camera/image_raw</topic>
          <update_rate>20.0</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>

